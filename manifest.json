{
  "manifest_version": 3,
  "name": "MornXReference",
  "version": "0.1.0",
  "description": "X (Twitter) のサイドバーに「ギャラリー」を追加し、ブックマークのメディアをページ内オーバーレイでグリッド自動再生して閲覧する。Live2D WIP リファレンス用。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://cdn.syndication.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MornXReference"
  }
}
