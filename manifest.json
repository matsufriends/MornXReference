{
  "manifest_version": 3,
  "name": "MornXReference",
  "version": "1.0.0",
  "description": "X (Twitter) のブックマークを自動読み込みしてメディアをグリッド状に自動再生して閲覧する。Live2D WIP リファレンス用。",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://cdn.syndication.twimg.com/*",
    "https://video.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/i/bookmarks*",
        "https://twitter.com/i/bookmarks*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MornXReference"
  }
}
